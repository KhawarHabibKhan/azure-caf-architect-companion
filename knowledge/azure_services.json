    "node_web_app": ["app_service", "cosmos_db"],
    "python_web_app": ["app_service", "postgresql_flexible"],
    "legacy_cobol": ["replace_with_saas"],
    "legacy_mainframe": ["replace_with_saas"],
    "file_shares": ["files"],
    "medical_imaging": ["blob"],
    "data_warehouse": ["data_lake"],
    "saas_already": ["retain"],
    "static_website": ["blob"],
    "wordpress": ["app_service", "mysql_flexible"],
