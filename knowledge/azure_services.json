      "use_for": ["rehost", "retain"],
      "pricing_meter": "Virtual Machines"
    },
    "app_service": {
      "name": "Azure App Service",
      "description": "PaaS for web apps, APIs, and mobile backends",
      "tiers": ["Free", "Basic", "Standard", "Premium v3"],
      "use_for": ["refactor"],
      "pricing_meter": "Azure App Service"
    },
    "aks": {
      "name": "Azure Kubernetes Service",
      "description": "Managed Kubernetes for containerized microservices",
      "use_for": ["rearchitect", "rebuild"],
      "pricing_meter": "Azure Kubernetes Service"
    },
    "container_apps": {
      "name": "Azure Container Apps",
      "description": "Serverless containers for event-driven microservices",
      "use_for": ["rearchitect", "rebuild"],
      "pricing_meter": "Azure Container Apps"
    },
    "functions": {
      "name": "Azure Functions",
